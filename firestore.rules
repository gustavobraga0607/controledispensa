rules_version = '2';

// Regras de segurança do Cloud Firestore para o app Dispensa.
// Só quem faz parte de uma casa enxerga e altera os dados dela.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function housePath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }
    function isMember(hid) {
      return signedIn() && request.auth.uid in get(housePath(hid)).data.members;
    }
    // Para gravações em lote (ex.: criar a casa e o perfil juntos).
    function isMemberAfter(hid) {
      return signedIn() && request.auth.uid in getAfter(housePath(hid)).data.members;
    }

    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid;

      // Membros podem renomear a casa, trocar o código de convite e sair (nunca adicionar outra pessoa).
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members.hasOnly(resource.data.members);

      // Quem tem o código de convite pode se adicionar (e só a si mesmo).
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode'])
        && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
        && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.householdId == hid;

      match /{col}/{id} {
        allow read: if isMember(hid);
        // Cada pessoa só altera o próprio perfil em /users.
        allow write: if isMemberAfter(hid) && (col != 'users' || id == request.auth.uid);
      }
    }

    // Convites: qualquer pessoa logada consulta um código específico (não dá para listar).
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if isMemberAfter(request.resource.data.householdId);
      allow delete: if isMember(resource.data.householdId);
    }
  }
}
